# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000
APP_NAME=Da3wa
DATABASE_URL=postgres://da3wa:da3wa@localhost:5432/da3wa
# 32+ random characters, e.g. `openssl rand -hex 32`
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Google sign-in (optional). Redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REQUIRE_EMAIL_VERIFICATION=false

# Transactional email via Resend (optional; logs to console when unset)
RESEND_API_KEY=
EMAIL_FROM="Da3wa <no-reply@example.com>"

# ---------------------------------------------------------------------------
# Storage: "local" (disk + /media route) or "s3" (AWS S3, Cloudflare R2, B2, MinIO)
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for objects, e.g. https://media.example.com
S3_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Payments: "mock" (test checkout inside the app) or "stripe"
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
# Webhook endpoint: {APP_URL}/api/payments/webhook/stripe
STRIPE_WEBHOOK_SECRET=
PRICE_CURRENCY=usd

# Allow publishing free events (with branding + RSVP limit) instead of requiring an upgrade
FREE_PUBLISH_ENABLED=false

# ---------------------------------------------------------------------------
# Spam protection (Cloudflare Turnstile, optional)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Messenger "send" dialog on desktop (optional)
FACEBOOK_APP_ID=
